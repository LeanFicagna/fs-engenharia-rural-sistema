# Copie para .env e preencha. O .env não vai para o Git.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Produção: PostgreSQL (Supabase, Session pooler). Vazio = SQLite local
DATABASE_URL=

# Apps Script da planilha de solicitações (a mesma URL do sheetsEndpoint da landing)
PLANILHA_URL=https://script.google.com/macros/s/SEU_ID/exec
PLANILHA_TOKEN=
